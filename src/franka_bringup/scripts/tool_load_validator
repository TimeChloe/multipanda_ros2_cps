"""Validate a real Panda's libfranka load against the unified tool YAML."""

from __future__ import annotations

import time
from typing import Iterable

import rclpy
from franka_msgs.msg import FrankaState
from rclpy.node import Node

from franka_bringup.tool_model import load_tool_description


def _max_error(actual: Iterable[float], expected: Iterable[float]) -> float:
    return max(abs(left - right) for left, right in zip(actual, expected))


class ToolLoadValidator(Node):
    def __init__(self) -> None:
        super().__init__("tool_load_validator")
        self.declare_parameter("tool_config", "")
        self.declare_parameter(
            "state_topic", "/franka_robot_state_broadcaster/robot_state"
        )
        self.declare_parameter("mass_tolerance", 1.0e-4)
        self.declare_parameter("com_tolerance", 1.0e-4)
        self.declare_parameter("inertia_tolerance", 1.0e-5)
        self.declare_parameter("state_timeout", 10.0)

        config_path = str(self.get_parameter("tool_config").value)
        if not config_path:
            raise RuntimeError("tool_config must not be empty")
        self._tool = load_tool_description(config_path)
        self._mass_tolerance = float(self.get_parameter("mass_tolerance").value)
        self._com_tolerance = float(self.get_parameter("com_tolerance").value)
        self._inertia_tolerance = float(self.get_parameter("inertia_tolerance").value)
        self._state_timeout = float(self.get_parameter("state_timeout").value)
        if min(
            self._mass_tolerance,
            self._com_tolerance,
            self._inertia_tolerance,
            self._state_timeout,
        ) <= 0.0:
            raise RuntimeError("tool-load tolerances and state_timeout must be positive")

        self._last_state = None
        self._start_time = time.monotonic()

        state_topic = str(self.get_parameter("state_topic").value)
        self._state_subscription = self.create_subscription(
            FrankaState, state_topic, self._state_callback, 10
        )
        self._timer = self.create_timer(0.5, self._check)

        self.get_logger().info(
            f"Strict tool-load check for '{self._tool.name}'; waiting for "
            f"{state_topic} (timeout={self._state_timeout:.3g} s)"
        )

    def _state_callback(self, message: FrankaState) -> None:
        self._last_state = message

    def _is_valid(self) -> tuple[bool, float, float, float]:
        mass_error = abs(float(self._last_state.m_load) - self._tool.mass)
        com_error = _max_error(self._last_state.f_x_cload, self._tool.com_parent)
        inertia_error = _max_error(
            self._last_state.i_load, self._tool.inertia_column_major
        )
        valid = (
            mass_error <= self._mass_tolerance
            and com_error <= self._com_tolerance
            and inertia_error <= self._inertia_tolerance
        )
        return valid, mass_error, com_error, inertia_error

    def _fail(self, reason: str) -> None:
        self.get_logger().fatal(reason)
        raise RuntimeError(reason)

    def _check(self) -> None:
        if self._last_state is None:
            elapsed = time.monotonic() - self._start_time
            if elapsed >= self._state_timeout:
                self._fail(
                    "No FrankaState received before the tool-load validation "
                    "deadline; stopping the real-robot launch."
                )
            return
        valid, mass_error, com_error, inertia_error = self._is_valid()
        if valid:
            self.get_logger().info(
                "One-time libfranka tool-load validation passed "
                f"(mass={self._tool.mass:.6g} kg); state subscription is disabled"
            )
            self._timer.cancel()
            self.destroy_subscription(self._state_subscription)
            self._state_subscription = None
            return

        self._fail(
            "libfranka tool load does not match tool.yaml; no robot parameter was "
            "changed. Stopping the real-robot launch. Maximum absolute errors: "
            f"mass={mass_error:.6g} kg (limit={self._mass_tolerance:.6g}), "
            f"com={com_error:.6g} m (limit={self._com_tolerance:.6g}), "
            f"inertia={inertia_error:.6g} kg*m^2 "
            f"(limit={self._inertia_tolerance:.6g})."
        )


def main(args=None) -> None:
    rclpy.init(args=args)
    node = None
    try:
        node = ToolLoadValidator()
        rclpy.spin(node)
    finally:
        if node is not None:
            node.destroy_node()
        if rclpy.ok():
            rclpy.shutdown()


if __name__ == "__main__":
    main()
