<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="metal_ball" params="ns connected_to radius:=0.03 mass:=0.2 xyz:='0 0 0.03' tcp_xyz:='0 0 0.06' rgba:='0.72 0.74 0.76 1.0'">
    <link name="${ns}_metal_ball_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
        <material name="${ns}_metal_ball_material">
          <color rgba="${rgba}"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="${radius}"/>
        </geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${0.4 * mass * radius * radius}" ixy="0" ixz="0"
          iyy="${0.4 * mass * radius * radius}" iyz="0"
          izz="${0.4 * mass * radius * radius}"/>
      </inertial>
    </link>

    <joint name="${ns}_metal_ball_joint" type="fixed">
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <parent link="${connected_to}"/>
      <child link="${ns}_metal_ball_link"/>
    </joint>

    <link name="${ns}_metal_ball_tcp_link"/>
    <joint name="${ns}_metal_ball_tcp_joint" type="fixed">
      <origin xyz="${tcp_xyz}" rpy="0 0 0"/>
      <parent link="${connected_to}"/>
      <child link="${ns}_metal_ball_tcp_link"/>
    </joint>
  </xacro:macro>
</robot>
