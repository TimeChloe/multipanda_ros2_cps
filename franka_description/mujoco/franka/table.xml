        conaffinity="0"/>
      </body>

      <!-- spring-supported compliant pad simulating human hand surface -->
      <!-- table top upper surface: z = 0.13 + 0.025 = 0.155 m -->
      <body name="human_hand_surface" pos="-0.30 0 0.23">
