      <geom
        name="spring_seg_05"
        type="capsule"
        fromto="-0.018 0.000 0.016  -0.013 -0.013 0.020"
        size="0.002"
        rgba="0.1 0.1 0.1 1"
        contype="0"
        conaffinity="0"/>

      <geom
        name="spring_seg_06"
        type="capsule"
        fromto="-0.013 -0.013 0.020  0.000 -0.018 0.024"
        size="0.002"
        rgba="0.1 0.1 0.1 1"
        contype="0"
