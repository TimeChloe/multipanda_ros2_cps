<mujoco model="table">
  <worldbody>
    <!-- Kinematic parent for the complete scenario fixture. Moving this mocap
         body keeps the table, visual spring, and compliant pad together while
         preserving the pad's local spring joint. -->
    <body name="table_assembly" mocap="true" pos="0 0 0">
      <body name="table" pos="-0.50 0 0.13">
      <!-- table top -->
      <geom
        name="table_top"
        type="box"
        size="0.30 0.20 0.025"
        rgba="0.55 0.35 0.20 1"
        contype="1"
        conaffinity="1"
        friction="1.0 0.005 0.0001"/>

      <!-- table legs -->
      <geom
        name="table_leg_fl"
        type="box"
        pos="0.23 0.15 -0.09"
        size="0.02 0.02 0.09"
        rgba="0.35 0.22 0.12 1"/>

      <geom
        name="table_leg_fr"
        type="box"
        pos="0.23 -0.15 -0.09"
        size="0.02 0.02 0.09"
        rgba="0.35 0.22 0.12 1"/>

      <geom
        name="table_leg_rl"
        type="box"
        pos="-0.23 0.15 -0.09"
        size="0.02 0.02 0.09"
        rgba="0.35 0.22 0.12 1"/>

      <geom
        name="table_leg_rr"
        type="box"
        pos="-0.23 -0.15 -0.09"
        size="0.02 0.02 0.09"
        rgba="0.35 0.22 0.12 1"/>
      </body>

      <!-- visual helical spring, display only, no collision -->
      <body name="hand_surface_spring_visual" pos="-0.30 0 0.160">
      <geom
        name="spring_seg_01"
        type="capsule"
        fromto="0.018 0.000 0.000  0.013 0.013 0.004"
        size="0.002"
        rgba="0.1 0.1 0.1 1"
        contype="0"
        conaffinity="0"/>

      <geom
        name="spring_seg_02"
        type="capsule"
        fromto="0.013 0.013 0.004  0.000 0.018 0.008"
        size="0.002"
        rgba="0.1 0.1 0.1 1"
        contype="0"
        conaffinity="0"/>

      <geom
        name="spring_seg_03"
        type="capsule"
        fromto="0.000 0.018 0.008  -0.013 0.013 0.012"
        size="0.002"
        rgba="0.1 0.1 0.1 1"
        contype="0"
        conaffinity="0"/>

      <geom
        name="spring_seg_04"
